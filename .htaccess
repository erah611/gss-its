# Root .htaccess for the site at the top of public_html (globalsoftsystems.com/).
#
# BEFORE THE FIRST DEPLOY: cPanel may keep its own rules in public_html/.htaccess,
# e.g. a block starting "# php -- BEGIN cPanel-generated handler, do not edit"
# that selects the PHP version, or HTTPS redirects. This file replaces that
# .htaccess on every deploy, so copy any such block from the server's current
# file into the space marked below first.

# ---- cPanel-generated rules (paste here, if any) ----

# ------------------------------------------------------

# Serve this site's index.html at the root even if an older site left an
# index.php behind in public_html.
DirectoryIndex index.html index.php

RewriteEngine On

# ── Clean URLs ──────────────────────────────────────────────────────────
# The pages live in html/ (html/about.html), but the address bar shows
# /about. Rules 1–4 send old addresses to the clean ones (they only act on
# what the visitor actually requested — THE_REQUEST — so they never fire on
# the internal rewrites below and can't loop). Rules 5–6 then map each
# clean address onto its file without changing the address bar.
# Local development mirrors these rules in tools/dev-router.php.

# 1. /index.html, /html, /html/, /html/index(.html) -> /
RewriteCond %{THE_REQUEST} \s/+(?:index\.html|html/?|html/index(?:\.html)?)[\s?] [NC]
RewriteRule ^ / [R=302,L]

# 2. Renamed pages and aliases: partner -> alliances, careers -> career
RewriteRule ^(?:html/)?partner(?:\.html)?/?$ /alliances [R=302,L,NC]
RewriteRule ^careers/?$ /career [R=302,L,NC]

# 3. /html/about or /html/about.html -> /about
RewriteCond %{THE_REQUEST} \s/+html/([a-z0-9-]+?)(?:\.html)?/?[\s?] [NC]
RewriteRule ^ /%1 [R=302,L,NE]

# 4. /about.html -> /about (only for pages that exist in html/)
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
RewriteCond %{DOCUMENT_ROOT}/html/%1.html -f
RewriteRule ^ /%1 [R=302,L,NE]

# 5. / -> html/index.html (internal)
RewriteRule ^$ html/index.html [L]

# 6. /about -> html/about.html (internal; real files and folders win)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/html/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ html/$1.html [L,NC]
